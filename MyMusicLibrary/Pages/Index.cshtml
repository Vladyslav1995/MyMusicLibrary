@page
@model IndexModel

@{
    ViewData["Title"] = "My Music Library";
}

<div id="three-container">

    <div class="music-overlay">
        <h1>My Music Library</h1>

        <p>
            Explore your music collection
        </p>

        <div class="music-buttons">

            <a asp-page="/Artists/Index"
               class="btn btn-primary">
                Artists
            </a>

            <a asp-page="/Albums/Index"
               class="btn btn-secondary">
                Albums
            </a>

            <a asp-page="/Songs/Index"
               class="btn btn-secondary">
                Songs
            </a>

            <a asp-page="/Search/Index"
               class="btn btn-secondary">
                Search
            </a>

        </div>
    </div>

</div>

@section Scripts {

    <script type="module"
            src="~/js/musicScene.js">
    </script>

}