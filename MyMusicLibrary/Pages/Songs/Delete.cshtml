@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "AdminOnly")]
@model MyMusicLibrary.Pages.Songs.DeleteModel

@{
    ViewData["Title"] = "Delete Song";
}

<h1>Delete Song</h1>

<h3>Are you sure you want to delete this song?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Song
        </dt>
        <dd class="col-sm-9">
            @Model.Song.Name
        </dd>

        <dt class="col-sm-3">
            Duration
        </dt>
        <dd class="col-sm-9">
            @TimeSpan.FromSeconds(Model.Song.DurationSeconds).ToString(@"mm\:ss")
        </dd>

        <dt class="col-sm-3">
            Album
        </dt>
        <dd class="col-sm-9">
            @Model.Song.Album?.Name
        </dd>

        <dt class="col-sm-3">
            Artist
        </dt>
        <dd class="col-sm-9">
            @Model.Song.Album?.Artist?.Name
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Song.Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>